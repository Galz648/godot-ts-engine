{
  "name": "{{slug}}",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "bun engine/packages/build/src/build.ts",
    "dev": "bun engine/packages/build/src/build.ts --watch",
    "pull": "bun engine/packages/build/src/build.ts --pull",
    "verify": "bun engine/packages/verify/src/verify.ts",
    "smoke": "${GODOT:-godot} --headless --fixed-fps 60 --path . -s res://tests/smoke.gd",
    "check": "tsc --noEmit -p scene-defs",
    "convert": "tstogd convert",
    "watch": "tstogd watch",
    "setup:editor": "cd engine/packages/lint-plugin && bun install && bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "~5.9",
    "typescript-to-gdscript": "^0.1.9"
  }
}
