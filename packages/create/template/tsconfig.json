{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "classic",
    "noLib": true,
    "strict": true,
    "noEmit": true,
    "types": [],
    "plugins": [
      { "name": "typescript-to-gdscript/ts-plugin" }
    ]
  },
  "include": ["node_modules/typescript-to-gdscript/typings", "src/**/*.ts", "src/_typings/**/*.d.ts"]
}
